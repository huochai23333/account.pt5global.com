{
  "name": "pt5-dropshipping-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:dashboard-ui": "node scripts/check-dashboard-structure.mjs",
    "check:operation-contracts": "node scripts/check-operation-contracts.mjs",
    "test:assistant-stream": "node --experimental-strip-types --test scripts/assistant-event-stream.test.mjs",
    "test:operation-receipts": "node --experimental-strip-types --test scripts/auth-operation-receipts.test.mjs scripts/operation-runs.test.mjs scripts/operator-reimbursement-receipts.test.mjs scripts/profile-operation-receipts.test.mjs scripts/storage-operation-receipts.test.mjs scripts/verified-action-outcome.test.mjs",
    "test:mail-intake": "node --experimental-strip-types --test scripts/mail-intake.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:regression": "npm run lint && npm run typecheck && npm run check:i18n && npm run check:dashboard-ui && npm run check:operation-contracts && npm run test:assistant-stream && npm run test:operation-receipts && npm run test:mail-intake && npm run build && npm run test:e2e",
    "clean:artifacts": "node scripts/clean-local-artifacts.mjs artifacts",
    "clean:cache": "node scripts/clean-local-artifacts.mjs cache",
    "clean:all": "node scripts/clean-local-artifacts.mjs all",
    "supabase:admin": "node scripts/supabase-admin.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@daypicker/react": "^10.0.1",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.100.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "google-auth-library": "10.3.0",
    "libphonenumber-js": "1.13.8",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next": "16.3.4",
    "next-intl": "^4.13.0",
    "nodemailer": "10.0.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "2.17.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "shadcn": "^4.1.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.4"
  }
}
