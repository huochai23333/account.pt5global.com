{
  "name": "pt5-dropshipping-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "check:learning": "node scripts/check-learning.mjs",
    "learning:refresh": "node scripts/learning/refresh-map.mjs",
    "test:learning": "node --test scripts/learning/*.test.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:dashboard-ui": "node scripts/check-dashboard-structure.mjs",
    "check:operation-contracts": "node scripts/check-operation-contracts.mjs",
    "test:public-site-origin": "node --experimental-strip-types --test scripts/public-site-origin.test.mjs",
    "test:mail-outbound-reconciliation": "node scripts/mail-outbound-reconciliation.test.cjs",
    "test:mail-inbound-recovery": "node --test scripts/mail-inbound-recovery.test.cjs",
    "test:mail-google-push": "node --test scripts/mail-google-push.test.cjs",
    "test:company-exchange-rate": "node --experimental-strip-types --test scripts/company-exchange-rate.test.mjs scripts/exchange-rate-sync-results.test.mjs",
    "test:settlement-unallocated": "node --experimental-strip-types --test scripts/wholesale-settlement-unallocated-summary.test.mjs",
    "test:server-request-body": "node --test scripts/server-request-body.test.mjs",
    "test:assistant-stream": "node --experimental-strip-types --test scripts/assistant-event-stream.test.mjs",
    "test:operation-receipts": "node --experimental-strip-types --test scripts/auth-operation-receipts.test.mjs scripts/operation-runs.test.mjs scripts/operator-reimbursement-receipts.test.mjs scripts/profile-operation-receipts.test.mjs scripts/storage-operation-receipts.test.mjs scripts/verified-action-outcome.test.mjs",
    "test:document-upload-recovery": "node --experimental-strip-types --test scripts/document-upload-recovery.test.mjs scripts/document-cleanup.test.mjs scripts/document-library-origin.test.mjs",
    "test:media-preview-cache": "node --experimental-strip-types --test scripts/user-media-preview-cache.test.mjs",
    "test:mail-intake": "node --experimental-strip-types --test scripts/mail-intake.test.mjs scripts/mail-routing-members.test.cjs",
    "test:mail-security": "node --experimental-strip-types --test scripts/mail-security.test.mjs",
    "test:login-recovery": "node --test scripts/login-recovery.test.cjs",
    "test:security-dependencies": "node --test scripts/security-dependencies.test.cjs scripts/minimatch-security.test.cjs",
    "test:public-login-recovery": "playwright test --config=tests/public/playwright.config.ts",
    "test:admin-auth-sync": "node tests/unit/admin-auth-sync-race.mjs && node tests/unit/admin-auth-sync-recovery.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:regression": "npm run lint && npm run typecheck && npm run check:i18n && npm run check:dashboard-ui && npm run check:operation-contracts && npm run check:learning && npm run test:learning && npm run test:recording && npm run test:contracts && npm run test:assistant-stream && npm run test:operation-receipts && npm run test:document-upload-recovery && npm run test:media-preview-cache && npm run test:mail-intake && npm run test:mail-security && npm run test:login-recovery && npm run test:security-dependencies && npm run test:admin-auth-sync && npm run test:company-exchange-rate && npm run test:settlement-unallocated && npm run test:public-site-origin && npm run test:server-request-body && npm run test:mail-outbound-reconciliation && npm run test:mail-inbound-recovery && npm run test:mail-google-push && npm run test:e2e-fixture-policy && npm run test:template-content-sandbox && npm run check:edge && npm run build && npm run test:e2e",
    "clean:artifacts": "node scripts/clean-local-artifacts.mjs artifacts",
    "clean:cache": "node scripts/clean-local-artifacts.mjs cache",
    "clean:all": "node scripts/clean-local-artifacts.mjs all",
    "supabase:admin": "node scripts/supabase-admin.mjs",
    "test:template-content-sandbox": "node scripts/template-content-sandbox.test.cjs",
    "test:e2e-fixture-policy": "node --experimental-strip-types --test scripts/e2e-fixture-policy.test.mjs",
    "test:record": "node scripts/record-test-run.mjs",
    "test:recording": "node --test scripts/record-test-run.test.mjs",
    "test:contracts": "playwright test --config=tests/contracts/playwright.config.ts",
    "check:edge": "node scripts/check-edge-functions.mjs",
    "check:learning:complete": "node scripts/check-learning.mjs --require-reviewed",
    "test:learning:browser": "playwright test --config=tests/learning/playwright.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@daypicker/react": "^10.0.1",
    "@supabase/ssr": "0.10.0",
    "@supabase/supabase-js": "2.100.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "google-auth-library": "10.3.0",
    "libphonenumber-js": "1.13.8",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next": "16.4.3",
    "next-intl": "^4.13.0",
    "nodemailer": "10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "2.18.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.32",
    "sharp": "0.35.5",
    "@typescript-eslint/typescript-estree@8.57.2": {
      "minimatch": "11.0.1"
    }
  }
}
